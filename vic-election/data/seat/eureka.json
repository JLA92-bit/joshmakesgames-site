atus":"contender","headline":"One Nation in contention","meaning":["The VEC is counting preferences between Liberal and Labor, but One Nation is ahead of Labor on first preferences. The real contest is likely Liberal against One Nation, and the projection uses that.","One Nation tops the first-preference vote on 28.7%, 1.8 points clear of Liberal.","To win, One Nation needs about 47.9% of the 44.4% of votes that went to other candidates to flow its way ahead of Liberal.","The VEC's preference count is between Liberal and Labor, so it expects One Nation to miss the final two. If One Nation beats one of them on primaries, the VEC will redo the preference count.","The Labor candidate is third on 17.6%. Labor voters tend to put One Nation last, which hurts it here."],"baseline":{"winner":{"candidate":"SETTLE, Michaela","code":"ALP"},"holder":{"code":"ALP","name":"SETTLE, Michaela","note":"Won at the 2022 election"},"final":[{"candidate":"SETTLE, Michaela","code":"ALP","pct":57.17},{"candidate":"TATCHELL, Paul","code":"LIB","pct":42.83}],"margin":7.17,"primary":{"LIB":31.65,"OTH":12.24,"GRN":10.8,"IND":4.35,"ALP":40.96}},"held_by":"ALP","mp":{"name":"SETTLE, Michaela","code":"ALP","note":"Won at the 2022 election","running":true,"pct":17.6},"swing":{"ALP":-23.4,"ON":28.7,"IND":-0.2,"GRN":5.5,"LIB":-4.8,"OTH":-5.8},"prior":{"winner":"LIB","win_prob":0.7721706894706866,"final":[{"candidate":"Liberal","code":"LIB","pct":55.22210190410604},{"candidate":"Labor","code":"ALP","pct":44.777898095893946}],"primary":{"LIB":30.85,"OTH":7.28,"GRN":15.44,"IND":3.07,"ALP":22.84,"ON":20.51}},"projection":{"winner":"LIB","win_prob":0.865,"final":[{"candidate":"MUIR, Emma","code":"LIB","pct":56.9},{"candidate":"BALLINGER, Paul","code":"ON","pct":43.1}],"basis":"preference model","sd":6.23,"on_win_prob":0.135,"live_weight":1.0}}